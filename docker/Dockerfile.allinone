# ==============================================================================
# Local-Jev 自己完結型 (All-in-One / Bake-in) 推論コンテナイメージ
# 
# デフォルトモデル (models/default) をコンテナイメージ内部に内包し,
# 外部ボリュームマウントなしで即時起動可能なオフライン配布向け定義。
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: CPU ベースイメージから派生
# ------------------------------------------------------------------------------
FROM local-jev:cpu AS base

USER root

# モデルアーティファクトの配置
COPY models/default /models/default

# 非 root ユーザーへの権限付与
RUN chown -R jev:jev /models

USER jev

# デフォルト Entrypoint & CMD (外部指定なしで即時動作)
ENTRYPOINT ["/usr/local/bin/local-jev"]
CMD ["serve", "--host", "0.0.0.0", "--port", "3000", "--model-dir", "/models/default"]
